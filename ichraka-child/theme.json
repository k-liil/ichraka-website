{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "ichraka-cream",       "color": "#FFF6E2", "name": "Cream" },
        { "slug": "ichraka-cream-2",     "color": "#FFEFCC", "name": "Cream foncé" },
        { "slug": "ichraka-ink",         "color": "#14213D", "name": "Encre" },
        { "slug": "ichraka-ink-soft",    "color": "#4A5577", "name": "Encre douce" },
        { "slug": "ichraka-yellow",      "color": "#FFD23F", "name": "Jaune" },
        { "slug": "ichraka-yellow-deep", "color": "#F5A623", "name": "Jaune foncé" },
        { "slug": "ichraka-coral",       "color": "#FF6B6B", "name": "Corail" },
        { "slug": "ichraka-coral-deep",  "color": "#E54B5C", "name": "Corail foncé" },
        { "slug": "ichraka-mint",        "color": "#2DD4BF", "name": "Menthe" },
        { "slug": "ichraka-mint-deep",   "color": "#0EA98D", "name": "Menthe foncée" },
        { "slug": "ichraka-sky",         "color": "#4FB3F0", "name": "Ciel" },
        { "slug": "ichraka-sky-deep",    "color": "#2E8FD0", "name": "Ciel foncé" },
        { "slug": "ichraka-plum",        "color": "#8E5BD9", "name": "Prune" }
      ],
      "gradients": [
        { "slug": "ichraka-hero",        "name": "Hero (corail / jaune / menthe)", "gradient": "linear-gradient(160deg,#FF6B6B,#FFD23F 60%,#2DD4BF)" },
        { "slug": "ichraka-cartables",   "name": "Cartables",                       "gradient": "linear-gradient(160deg,#FFB800,#FF7E51)" },
        { "slug": "ichraka-vetements",   "name": "Vêtements",                       "gradient": "linear-gradient(160deg,#FF8A8A,#8E5BD9)" },
        { "slug": "ichraka-lunettes",    "name": "Lunettes",                        "gradient": "linear-gradient(160deg,#5DEAD3,#4FB3F0)" }
      ],
      "custom": false,
      "customGradient": true,
      "link": true
    },
    "typography": {
      "fontFamilies": [
        { "slug": "display", "name": "Bricolage Grotesque (display)", "fontFamily": "'Bricolage Grotesque', system-ui, sans-serif" },
        { "slug": "body",    "name": "Manrope (corps)",                "fontFamily": "'Manrope', system-ui, sans-serif" },
        { "slug": "arabic",  "name": "Cairo (arabe)",                  "fontFamily": "'Cairo', 'Tajawal', system-ui, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small",    "size": "0.85rem", "name": "Petit" },
        { "slug": "medium",   "size": "1rem",    "name": "Moyen" },
        { "slug": "large",    "size": "1.2rem",  "name": "Grand" },
        { "slug": "x-large",  "size": "2rem",    "name": "Très grand" },
        { "slug": "xx-large", "size": "3.5rem",  "name": "Énorme" }
      ],
      "fluid": true,
      "lineHeight": true,
      "fontWeight": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "layout": {
      "contentSize": "880px",
      "wideSize": "1480px"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--ichraka-cream)",
      "text": "var(--wp--preset--color--ichraka-ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "1rem",
      "lineHeight": "1.55"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "lineHeight": "0.95",
          "letterSpacing": "-0.03em",
          "fontSize": "clamp(3rem,8vw,7rem)"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "lineHeight": "1",
          "letterSpacing": "-0.025em",
          "fontSize": "clamp(2.5rem,5.5vw,4.6rem)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "lineHeight": "1.15",
          "fontSize": "1.6rem"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--ichraka-coral)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--ichraka-coral-deep)" }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ichraka-coral)",
          "text": "#ffffff"
        },
        "border": { "radius": "999px" },
        "spacing": {
          "padding": {
            "top": "1rem",
            "bottom": "1rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "700"
        }
      }
    }
  }
}
