{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "ichraka-primary",        "color": "#E8780A", "name": "Ichraka — Orange" },
        { "slug": "ichraka-primary-dark",   "color": "#C4640A", "name": "Ichraka — Orange foncé" },
        { "slug": "ichraka-primary-light",  "color": "#FFA640", "name": "Ichraka — Orange clair" },
        { "slug": "ichraka-secondary",      "color": "#2980B9", "name": "Ichraka — Bleu" },
        { "slug": "ichraka-secondary-dark", "color": "#1F5F8B", "name": "Ichraka — Bleu foncé" },
        { "slug": "ichraka-accent",         "color": "#27AE60", "name": "Ichraka — Vert (don)" },
        { "slug": "ichraka-text",           "color": "#2C3E50", "name": "Texte principal" },
        { "slug": "ichraka-text-light",     "color": "#5D6D7E", "name": "Texte secondaire" },
        { "slug": "ichraka-bg",             "color": "#FFFFFF", "name": "Fond blanc" },
        { "slug": "ichraka-bg-soft",        "color": "#FDF6EE", "name": "Fond crème" },
        { "slug": "ichraka-bg-section",     "color": "#F8F9FA", "name": "Fond gris clair" }
      ],
      "gradients": [
        {
          "slug": "ichraka-sunrise",
          "name": "Lever de soleil Ichraka",
          "gradient": "linear-gradient(135deg,#FFF4E5 0%,#FFE0B3 100%)"
        },
        {
          "slug": "ichraka-blue",
          "name": "Bleu Ichraka",
          "gradient": "linear-gradient(135deg,#2980B9 0%,#1F5F8B 100%)"
        }
      ],
      "custom": false,
      "customGradient": true,
      "link": true
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Montserrat (titres)",
          "fontFamily": "'Montserrat','Helvetica Neue',Arial,sans-serif"
        },
        {
          "slug": "body",
          "name": "Open Sans (texte)",
          "fontFamily": "'Open Sans','Helvetica Neue',Arial,sans-serif"
        },
        {
          "slug": "arabic",
          "name": "Cairo (arabe)",
          "fontFamily": "'Cairo','Tajawal','Segoe UI',sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small",   "size": "0.875rem", "name": "Petit" },
        { "slug": "medium",  "size": "1rem",     "name": "Moyen" },
        { "slug": "large",   "size": "1.25rem",  "name": "Grand" },
        { "slug": "x-large", "size": "1.75rem",  "name": "Très grand" },
        { "slug": "xx-large","size": "2.5rem",   "name": "Énorme" }
      ],
      "fluid": true,
      "lineHeight": true,
      "fontWeight": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      }
    },
    "layout": {
      "contentSize": "880px",
      "wideSize": "1200px"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "blocks": {
      "core/button": {
        "color": {
          "palette": [
            { "slug": "donate", "color": "#27AE60", "name": "Bouton de don" },
            { "slug": "primary","color": "#E8780A", "name": "Bouton principal" }
          ]
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--ichraka-bg)",
      "text": "var(--wp--preset--color--ichraka-text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "1rem",
      "lineHeight": "1.65"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.2",
          "fontSize": "clamp(2rem,4vw,3rem)"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.25",
          "fontSize": "clamp(1.6rem,3vw,2.25rem)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600",
          "lineHeight": "1.3",
          "fontSize": "clamp(1.3rem,2.5vw,1.75rem)"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--ichraka-primary)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--ichraka-primary-dark)" }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ichraka-primary)",
          "text": "#ffffff"
        },
        "border": { "radius": "8px" },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600",
          "textTransform": "uppercase",
          "letterSpacing": "0.5px"
        },
        ":hover": {
          "color": { "background": "var(--wp--preset--color--ichraka-primary-dark)" }
        }
      }
    }
  },
  "customTemplates": [
    { "name": "page-accueil",    "title": "Ichraka — Accueil",    "postTypes": ["page"] },
    { "name": "page-operations", "title": "Ichraka — Opérations", "postTypes": ["page"] },
    { "name": "page-don",        "title": "Ichraka — Don",        "postTypes": ["page"] },
    { "name": "page-contact",    "title": "Ichraka — Contact",    "postTypes": ["page"] }
  ]
}
